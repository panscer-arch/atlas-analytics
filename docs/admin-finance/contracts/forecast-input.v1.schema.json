{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-system.internal/schemas/admin-finance/forecast-input.v1.schema.json",
  "title": "Atlas Admin Finance committed forecast input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSnapshotId", "generatedAt", "perimeter", "payoutContractAddress", "token", "checkpoint", "reservePolicy", "forecastPolicy", "openingLiquidityRaw", "buckets"],
  "properties": {
    "schemaVersion": { "const": "atlas.forecast-input.v1" },
    "sourceSnapshotId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "perimeter": { "const": "payout_contract" },
    "payoutContractAddress": { "$ref": "#/$defs/address" },
    "token": { "$ref": "#/$defs/token" },
    "checkpoint": { "$ref": "#/$defs/checkpoint" },
    "reservePolicy": { "$ref": "#/$defs/reservePolicy" },
    "forecastPolicy": { "$ref": "#/$defs/forecastPolicy" },
    "openingLiquidityRaw": { "$ref": "#/$defs/atomic" },
    "buckets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 366,
      "items": { "$ref": "#/$defs/bucket" }
    }
  },
  "$defs": {
    "atomic": { "type": "string", "minLength": 1, "maxLength": 78, "pattern": "^(0|[1-9][0-9]*)$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "symbol", "decimals"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 36 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "asOf", "blockNumber", "blockHash", "confirmations", "finality", "liquidityVerification"],
      "properties": {
        "chainId": { "const": 56 },
        "asOf": { "type": "string", "format": "date-time" },
        "blockNumber": { "type": "integer", "minimum": 1 },
        "blockHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "confirmations": { "type": "integer", "minimum": 0 },
        "finality": { "const": "finalized" },
        "liquidityVerification": { "const": "independent_rpc" }
      }
    },
    "reservePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "approvedAt", "reserveTargetRaw"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "const": "approved" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "reserveTargetRaw": { "$ref": "#/$defs/atomic" }
      }
    },
    "forecastPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "approvedAt", "scenario", "unconfirmedFutureInflow"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "const": "approved" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "scenario": { "const": "committed" },
        "unconfirmedFutureInflow": { "const": "exclude" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grossRaw", "netRaw", "platformFeeRaw", "otherDeductionsRaw"],
      "properties": {
        "grossRaw": { "$ref": "#/$defs/atomic" },
        "netRaw": { "$ref": "#/$defs/atomic" },
        "platformFeeRaw": { "$ref": "#/$defs/atomic" },
        "otherDeductionsRaw": { "$ref": "#/$defs/atomic" }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bucketStart", "bucketEnd", "cycleCount", "pendingPartnerCreationCount", "principalDueRaw", "grossDelta", "partnerRewardStreamed", "pendingPartnerRewardAtCreation", "confirmedInflowRaw", "inflowEvidence", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "bucketStart": { "type": "string", "format": "date-time" },
        "bucketEnd": { "type": "string", "format": "date-time" },
        "cycleCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "pendingPartnerCreationCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "principalDueRaw": { "$ref": "#/$defs/atomic" },
        "grossDelta": { "$ref": "#/$defs/component" },
        "partnerRewardStreamed": { "$ref": "#/$defs/component" },
        "pendingPartnerRewardAtCreation": { "$ref": "#/$defs/component" },
        "confirmedInflowRaw": { "$ref": "#/$defs/atomic" },
        "inflowEvidence": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  }
}
