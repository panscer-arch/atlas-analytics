# Copy values from the deployment secret manager. Never commit the populated file.
ATLAS_ADMIN_FINANCE_STAGING_ORIGIN=https://finance-staging.example.com
ATLAS_ADMIN_FINANCE_STAGING_BIND=127.0.0.1
ATLAS_ADMIN_FINANCE_STAGING_PORT=8088

ATLAS_ADMIN_FINANCE_CURSOR_SECRET=generate-at-least-32-random-characters
ATLAS_ADMIN_FINANCE_SESSION_TOKEN=generate-at-least-32-random-characters

ATLAS_ADMIN_FINANCE_RPC_URL=https://approved-archive-rpc.example.com/read-only-key
ATLAS_ADMIN_FINANCE_RPC_HOSTS=approved-archive-rpc.example.com
# Candidate allowlist independently checked at BSC block 114407352. Keep staging
# closed until controlled-address-registry.v1.json receives owner approval.
ATLAS_ADMIN_FINANCE_CONTRACT_ADDRESSES=0x8F6daC6F25A5038112E1A01f1cBBD682e4D64889,0x8e61483d45a822cCB59482c47e1b6D28465605EC,0x8F418e29a32AAB69Abf3DA742c43E7aDfBFbA3c3,0x5a71807861dBFc41aB016271C3191bF96322D42e,0xEF156690b98AEc4F805Ec820268B9092bd83B76f
ATLAS_ADMIN_FINANCE_MIN_CONFIRMATIONS=12

# Reserved for a later reviewed worker service. Current staging compose forces
# this off and does not accept Telegram/email provider secrets.
ATLAS_ADMIN_FINANCE_NOTIFICATIONS_MODE=shadow

# Restore-drill runner only. Supply both URLs and the CA through the deployment
# secret manager. The restore database must be separate, empty, and contain
# restore, drill, or scratch in its name. These values are not consumed by the
# current read-only MVP Compose stack.
# ATLAS_ADMIN_FINANCE_DATABASE_URL=postgresql://migration-role:secret@postgres.example.com/atlas_finance
# ATLAS_ADMIN_FINANCE_RESTORE_DATABASE_URL=postgresql://restore-role:secret@postgres.example.com/atlas_finance_restore_drill
# ATLAS_ADMIN_FINANCE_DATABASE_CA_FILE=/run/secrets/postgres-ca.pem
# ATLAS_ADMIN_FINANCE_BACKUP_PATH=/secure-backups/atlas-finance-pre-migration.dump

# R1.1 opt-in only. These values are consumed only when compose.forecast.yaml
# is explicitly included. The provider credential stays server-side.
# ATLAS_ADMIN_FINANCE_DATABASE_CA_HOST_FILE=/run/secrets/admin-finance-postgres-ca.pem
# ATLAS_ADMIN_FINANCE_FORECAST_URL=https://data.atlas-system.io/api/v1/admin-finance/forecast-input
# ATLAS_ADMIN_FINANCE_FORECAST_AUTHORIZATION=secret-manager-reference
# ATLAS_ADMIN_FINANCE_PAYOUT_CONTRACT=approved-payout-contract
# ATLAS_ADMIN_FINANCE_FORECAST_MIN_CONFIRMATIONS=12
