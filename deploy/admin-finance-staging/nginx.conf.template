limit_req_zone $binary_remote_addr zone=admin_finance_api:10m rate=10r/s;

server {
  listen 8080;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  client_max_body_size 16k;

  add_header Cache-Control "no-store" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Cross-Origin-Resource-Policy "same-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;

  location /api/admin/v1/ {
    limit_except GET { deny all; }
    limit_req zone=admin_finance_api burst=20 nodelay;

    proxy_set_header Authorization "";
    proxy_set_header Cookie "__Host-atlas_admin_session=${ATLAS_ADMIN_FINANCE_SESSION_TOKEN}";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_pass http://api:8791;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 10s;
  }

  location ~ ^/(admin(?:/|$)|admin-finance\.html$|assets/|generated/) {
    try_files $uri $uri/ /admin-finance.html;
  }

  location / {
    return 404;
  }
}
